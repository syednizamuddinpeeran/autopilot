# Git branch rules for this repository's own guard. KEY="value" lines; humans edit, agents cannot.
# Branch prefixes agents may push from: agent/copilot/claude branches, cloud session branches
# (ccr-*) and stacked part branches (part/*). Never main.
BRANCH_PREFIXES="agent/ copilot/ claude/ ccr- part/"
# git subcommands allowed only on those branches.
BRANCH_ONLY_GIT="push"
# 1 = any explicit git push refspec must name the current branch.
PUSH_CURRENT_BRANCH_ONLY="1"
