
# Cloud: aws. run-issue/run-task refuse to start an agent while any of these is set, so a local
# agent never inherits AWS credentials. Deploys run from CI after a human merges (see docs/aws.md).
FORBIDDEN_ENV="AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_PROFILE AWS_DEFAULT_PROFILE AWS_WEB_IDENTITY_TOKEN_FILE AWS_ROLE_ARN AWS_CONTAINER_CREDENTIALS_FULL_URI AWS_CONTAINER_CREDENTIALS_RELATIVE_URI"
