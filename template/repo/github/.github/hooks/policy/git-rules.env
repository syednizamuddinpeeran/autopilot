# Git branch rules for the guard (repo type: github). Read by guard.sh and guard.ps1.
# KEY="value" lines only; humans edit, agents cannot (.github/hooks/ is write-protected).

# Branch prefixes agents may work on (space separated). FACTORY_BRANCH_PREFIXES overrides.
BRANCH_PREFIXES="agent/ copilot/ claude/"
# git subcommands that are allowed only on those branches (regex alternation).
BRANCH_ONLY_GIT="push"
# 1 = any explicit git push refspec must name the current branch.
PUSH_CURRENT_BRANCH_ONLY="1"
